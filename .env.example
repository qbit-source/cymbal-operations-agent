# GCP Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=<PROJECT_ID>
PROJECT_ID=<PROJECT_ID>
GOOGLE_CLOUD_LOCATION=global
REGION=us-central1
SERVICE_ACCOUNT=cymbal-sa-data@<PROJECT_ID>.iam.gserviceaccount.com

# BigQuery Conversational Data Agent
DATA_AGENT_ID=cymbal-retail-analytics-data-agent
DATA_AGENT_RESOURCE_NAME=projects/<PROJECT_ID>/locations/global/dataAgents/cymbal-retail-analytics-data-agent

# Cloud Bigtable Configuration
BIGTABLE_INSTANCE_ID=operations-db
BIGTABLE_TABLE_ID=cashier_realtime_alerts
BIGTABLE_ENRICHED_TABLE_ID=pos_transactions_enriched

# Bigtable MCP Microservice
BIGTABLE_MCP_URL=https://mcp-toolbox-bigtable-519629786311.us-central1.run.app

# Telemetry
BQ_TELEMETRY_DATASET=agent_telemetry
